# Nginx Multi-Tenant Reverse Proxy Configuration Example
# Powers RoseFlix, AniRose, and DramaPulse from a single server deployment

# 1. RoseFlix (Movies & TV Hub) -> Port 3001
server {
    listen 80;
    server_name roseflix.com www.roseflix.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name roseflix.com www.roseflix.com;

    # SSL Certificates (managed via Certbot or custom provider)
    # ssl_certificate /etc/letsencrypt/live/roseflix.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/roseflix.com/privkey.pem;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml font/woff2;

    # Real-Time Watch Party SSE Stream (Crucial: disable buffering for live sync)
    location /api/party/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Disable all caching & proxy buffering for instant SSE delivery
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Next.js Static Assets Caching
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # App Traffic
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# 2. AniRose (Simulcast Anime Hub) -> Port 3002
server {
    listen 80;
    server_name anirose.com www.anirose.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name anirose.com www.anirose.com;

    # SSL Certificates
    # ssl_certificate /etc/letsencrypt/live/anirose.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/anirose.com/privkey.pem;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml font/woff2;

    # Watch Party SSE Endpoint
    location /api/party/ {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location /_next/static/ {
        proxy_pass http://127.0.0.1:3002;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

